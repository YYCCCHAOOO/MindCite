{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindCite Reading Status Row",
  "type": "object",
  "required": [
    "schema_version",
    "item_key",
    "status",
    "title",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "item_key": {"type": "string"},
    "status": {"type": "string", "enum": ["done", "needs_pdf", "needs_note", "skipped", ""]},
    "title": {"type": "string"},
    "target": {"type": ["string", "null"]},
    "note_path": {"type": ["string", "null"]},
    "updated_at": {"type": "string"},
    "reason": {"type": ["string", "null"]},
    "source_warning": {"type": ["string", "null"]},
    "low_information_source": {"type": ["boolean", "null"]}
  }
}
