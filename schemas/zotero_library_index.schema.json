{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindCite Zotero Library Index Row",
  "type": "object",
  "required": [
    "schema_version",
    "item_key",
    "title",
    "item_type",
    "collection_paths",
    "primary_collection_path",
    "has_pdf",
    "has_fulltext_cache",
    "zotero_select_uri",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "item_key": {"type": "string"},
    "title": {"type": "string"},
    "item_type": {"type": "string"},
    "year": {"type": ["string", "null"]},
    "doi": {"type": ["string", "null"]},
    "authors": {"type": "array"},
    "publication_title": {"type": ["string", "null"]},
    "collection_paths": {"type": "array"},
    "primary_collection_path": {"type": "string"},
    "pdf_paths": {"type": "array"},
    "fulltext_cache_paths": {"type": "array"},
    "has_pdf": {"type": "boolean"},
    "has_fulltext_cache": {"type": "boolean"},
    "zotero_select_uri": {"type": ["string", "null"]},
    "zotero_open_pdf_uri": {"type": ["string", "null"]},
    "reading_status": {"type": ["string", "null"]},
    "updated_at": {"type": "string"}
  }
}
