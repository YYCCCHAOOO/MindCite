# 复制为 .env 后再填写。不要把 .env 提交到 GitHub。

# 可选：不填时默认使用当前仓库目录。
RESEARCHVAULT_ROOT=

# Zotero 本地数据库与 storage 路径。Windows 示例请自行替换成你的真实路径。
ZOTERO_DB_PATH=
ZOTERO_SNAPSHOT_DB_PATH=
ZOTERO_STORAGE_PATH=

# LLM 与 embedding API key。公开仓库只放变量名，不放真实密钥。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# 可选：自定义配置文件位置。
RESEARCHVAULT_CONFIG=
