# 复制为 .env 后再填写。不要把 .env 提交到 GitHub。

# 可选：不填时默认使用当前仓库目录。
MINDCITE_ROOT=

# Zotero 本地数据库与 storage 路径。Windows 示例请自行替换成你的真实路径。
ZOTERO_DB_PATH=
ZOTERO_SNAPSHOT_DB_PATH=
ZOTERO_STORAGE_PATH=

# LLM 产商与模型。可选：deepseek / openai / qwen / zhipu / custom。
MINDCITE_LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
DASHSCOPE_MODEL=qwen-plus
ZHIPU_MODEL=glm-4-flash
MINDCITE_LLM_BASE_URL=
MINDCITE_LLM_MODEL=

# Embedding 产商与模型。可选：siliconflow / openai / custom。
MINDCITE_EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MINDCITE_EMBEDDING_URL=
MINDCITE_EMBEDDING_MODEL=

# LLM 与 embedding API key。公开仓库只放变量名，不放真实密钥。
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MINDCITE_LLM_API_KEY=
MINDCITE_EMBEDDING_API_KEY=

# 可选：自定义配置文件位置。
MINDCITE_CONFIG=
